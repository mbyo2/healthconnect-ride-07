# Required for every host (Vercel, Docker, or a static host).
# On Vercel these live in Project Settings -> Environment Variables (Production).
VITE_SUPABASE_URL=https://tthzcijscedgxjfnfnky.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_PROJECT_ID=tthzcijscedgxjfnfnky
VITE_SITE_URL=https://doc0clock.online

# Required for browser/mobile push subscriptions (client asks Notification
# permission and subscribes with this key). Pair with the server-side
# VAPID_PRIVATE_KEY Supabase secret. Generate a pair with:
#   npx web-push generate-vapid-keys --json
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Optional. Zambia: 991 (ambulance) is the default; 112 also works on mobile networks.
# Set this to the emergency number appropriate to your deployed region.
VITE_EMERGENCY_NUMBER=991
